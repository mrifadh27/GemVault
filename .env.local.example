# ============================================================
# GemVault — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ─── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ──────────────────────────────────────────────
# From: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Stripe ────────────────────────────────────────────────
# From: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# From: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend ────────────────────────────────────────────────
# From: https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=GemVault <noreply@yourdomain.com>

# ─── Supabase Storage Buckets (create these in Supabase dashboard) ───
# product-images  → public bucket
# certificates    → public bucket
# avatars         → public bucket
